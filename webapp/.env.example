# Server-side API proxy target for the FastAPI backend.
# Local dev example when backend is started with:
#   python -m uvicorn api.index:app --host 0.0.0.0 --port 8002
# INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:8002
INKSIGHT_BACKEND_API_BASE=http://127.0.0.1:8080

# Optional browser-side firmware API base. Leave empty to use same-origin
# Next.js API routes, which proxy through INKSIGHT_BACKEND_API_BASE.
NEXT_PUBLIC_FIRMWARE_API_BASE=
