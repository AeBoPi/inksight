  },
  "layout": {
    "layout_engine": "component_tree",
    "status_bar": {
      "line_width": 1,
      "dashed": false
    },
    "component_theme": {
      "body_font": "lora_regular",
      "body_font_size": 13,
      "body_line_gap": 5,
      "section_title_font": "lora_regular",
      "section_title_font_size": 13,
      "section_icon_size": 13,
      "section_icon_gap": 16,
      "section_title_gap": 6,
      "section_content_indent": 36,
      "section_content_gap": 4
    },
    "body": {
      "type": "column",
      "padding_x": 18,
      "padding_y": 6,
      "gap": 4,
      "justify": "space_between",
      "children": [
        {
          "type": "section_box",
          "title": "HN Top",
          "icon": "global",
          "children": [
            {
              "type": "repeat",
              "field": "hn_items",
              "limit": 2,
              "gap": 6,
              "item": {
                "type": "row",
                "gap": 8,
                "align": "end",
                "children": [
                  {
                    "type": "text",
                    "field": "title",
                    "grow": 1,
                    "align": "left",
                    "max_lines": 2
                  },
                  {
                    "type": "text",
                    "field": "score",
                    "font": "inter_medium",
                    "font_size": 13,
                    "align": "right",
                    "max_lines": 1
                  }
                ]
              }
            }
          ]
        },
        {
          "type": "section_box",
          "title": "Dev.to",
          "icon": "app",
          "children": [
            {
              "type": "repeat",
              "field": "devto_items",
              "limit": 2,
              "gap": 6,
              "item": {
                "type": "text",
                "field": "title",
                "align": "left",
                "max_lines": 2,
                "line_height": 18
              }
            }
          ]
        },
        {
          "type": "section_box",
          "title": "ProductHunt",
          "icon": "star",
          "children": [
            {
              "type": "column",
              "gap": 4,
              "children": [
                {
                "type": "text",
                  "field": "ph_name",
                  "align": "left",
                  "max_lines": 1
                },
                {
                  "type": "text",
                  "field": "ph_tagline",
                  "align": "left",
                  "max_lines": 2,
                  "ellipsis": false,
                  "line_height": 18
                }
              ]
            }
          ]
        }
      ]
    },
    "footer": {
      "label": "Briefing",
      "attribution_template": "— Tech Brief"
    }
  },
  "layout_overrides": {
    "296x128": {
      "component_theme": {
        "body_font_size": 10,
        "body_line_gap": 4,
        "section_title_font_size": 10,
        "section_icon_size": 10,
        "section_icon_gap": 12,
        "section_title_gap": 4,
        "section_content_indent": 18,
        "section_content_gap": 2
      },
      "body": {
        "padding_x": 8,
        "padding_y": 4,
        "gap": 4
      },
      "footer": {
        "label": "Briefing",
        "height": 18
      }
    },
    "800x480": {
      "component_theme": {
        "body_font_size": 16,
        "body_line_gap": 8,
        "section_title_font_size": 18,
        "section_icon_size": 18,
        "section_icon_gap": 24,
        "section_title_gap": 10,
        "section_content_indent": 56,
        "section_content_gap": 6
      },
      "body": {
        "padding_x": 28,
        "padding_y": 10,
        "gap": 14
      }
    }
  }
}
